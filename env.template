# ==========================================
# Configuración del Servidor y Red
# ==========================================
# PORT: Es el puerto que el servidor real (host) expondrá hacia afuera.
# Si el 3000 está ocupado por el scraper u otra app, cámbialo aquí (ej. 3002).
PORT=3000

# APP_PORT: Es el puerto interno donde escucha NestJS dentro del contenedor. 
# Se recomienda dejarlo en 3000 para consistencia con el Dockerfile.
APP_PORT=3000

# ==========================================
# Configuración de la Base de Datos (MySQL)
# ==========================================
DB_HOST=localhost #Sí se va a desplegar con docker, host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=enterprise_db

# ==========================================
# Configuración de Autenticación y Seguridad
# ==========================================
# Clave secreta para firmar los tokens JWT y credenciales del administrador
# En producción, usa una cadena larga y aleatoria (ej. generada con 'openssl rand -base64 32')
JWT_SECRET=una_clave_larga_y_segura
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=contraseña_muy_segura_aqui