# Base de datos
# En contenedor Docker apuntando al MySQL del host: DB_HOST=host.docker.internal
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=enterprise_db

JWT_SECRET=change-me
PORT=3000
NODE_ENV=production

# Primer admin (solo si la tabla users está vacía)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=Admin1234!
# Correo del admin (solo MFA; el aislamiento por agente usa `username` = record.agent)
DEFAULT_ADMIN_EMAIL=admin@example.com

# SMTP (obligatorio si MFA está activo y los usuarios hacen login con segundo factor)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mi App <no-reply@example.com>"

# Origen permitido en CORS (main.ts). En desarrollo suele ser http://localhost:5173
FRONTEND_URL=*
